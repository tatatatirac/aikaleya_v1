DJANGO_SECRET_KEY=change-this-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,aikaleya.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://aikaleya.com
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Dev default uses SQLite. Production example:
# DATABASE_URL=postgres://kaleya_user:strong_password@127.0.0.1:5432/kaleya_db
DATABASE_URL=

# AI provider: anthropic or openai
AI_PROVIDER=anthropic

# Anthropic / Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# OpenAI is optional. Leave empty if you use Claude.
OPENAI_API_KEY=
OPENAI_MODEL=

# ElevenLabs voice
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
REDIS_URL=redis://127.0.0.1:6379/0
