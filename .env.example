DJANGO_SECRET_KEY=change-this-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,aikaleya.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://aikaleya.com
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Dev default uses SQLite. Production example:
# DATABASE_URL=postgres://kaleya_user:strong_password@127.0.0.1:5432/kaleya_db
DATABASE_URL=

# AI provider: anthropic or openai
AI_PROVIDER=anthropic

# Anthropic / Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# OpenAI is optional. Leave empty if you use Claude.
OPENAI_API_KEY=
OPENAI_MODEL=

# ElevenLabs voice
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Payment provider
# Use manual until PayPal business account, products and subscription plans are ready.
PAYMENT_PROVIDER=manual
PAYMENT_SUCCESS_URL=https://aikaleya.com/?payment=success
PAYMENT_CANCEL_URL=https://aikaleya.com/?payment=cancel

# PayPal Checkout / Subscriptions
# PAYPAL_ENVIRONMENT=sandbox for testing, live for production.
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_PLAN_BASIC=
PAYPAL_PLAN_PRO=
PAYPAL_PLAN_BUSINESS=
PAYPAL_PLAN_BUSINESS_PLUS=
PAYPAL_PLAN_BUSINESS_PRO_PLUS=

# Optional legacy Stripe support. Leave empty if you use PayPal.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BASIC=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=
STRIPE_PRICE_BUSINESS_PLUS=
STRIPE_PRICE_BUSINESS_PRO_PLUS=

# Local demo admin account
KALEYA_DEMO_ADMIN_EMAIL=admin@example.com
KALEYA_DEMO_ADMIN_PASSWORD=change-me-local-only
REDIS_URL=redis://127.0.0.1:6379/0

# API rate limits
DRF_ANON_THROTTLE_RATE=80/hour
DRF_USER_THROTTLE_RATE=1200/hour

# Email dev default prints emails in terminal.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Kaleya <no-reply@aikaleya.com>

# Local JSON backups created by manage.py backup_data
DATA_BACKUP_DIR=backups
DJANGO_LOG_LEVEL=INFO
