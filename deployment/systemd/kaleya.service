[Unit]
Description=Kaleya ASGI application
After=network.target redis-server.service postgresql.service

[Service]
User=www-data
Group=www-data
WorkingDirectory=/var/www/aikaleya/backend
EnvironmentFile=/var/www/aikaleya/.env
ExecStart=/var/www/aikaleya/.venv/bin/daphne -b 127.0.0.1 -p 8000 kaleya_config.asgi:application
Restart=always
RestartSec=5
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
